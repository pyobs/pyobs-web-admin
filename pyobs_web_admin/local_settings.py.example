# Local overrides — copy this file to local_settings.py and fill in the values.
# local_settings.py is not committed to version control.

# Generate with:
#   DJANGO_SETTINGS_MODULE=pyobs_web_admin.settings uv run python -c \
#     "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY = ""

DEBUG = False
ALLOWED_HOSTS = ["your-hostname-or-ip"]

# Enable once HTTPS is in place
# SESSION_COOKIE_SECURE = True
# CSRF_COOKIE_SECURE = True

# Path to the pyobs executable
PYOBS_EXEC = "/opt/pyobs/venv/bin/pyobs"

# pyobs directories
PYOBS_CONFIG_DIR = "/opt/pyobs/config"
PYOBS_LOG_DIR = "/opt/pyobs/log"
PYOBS_RUN_DIR = "/opt/pyobs/run"
PYOBS_LOG_LEVEL = "info"

# Where module logs live -- see DEV_JOURNALD_LOGS.md. None (default) auto-detects from
# pyobsd's own config file. Set explicitly to "file" or "journald" to override.
# PYOBS_LOG_BACKEND = None

# Packages page: what's installed (via `pip list`) is always the primary source of truth,
# this is only for what pip's own installed-environment metadata can't recover later --
# an extras spec (pip never remembers a package was installed with "[full]", so a later
# upgrade would silently drop it) and/or extra non-"pyobs"-prefixed packages to also show
# and manage from the same page. pyobs-core is installed with the "full" extra by default.
# A PEP 508 direct reference (e.g. "pyobs-iagvt[gui] @ git+https://...") also works, for a
# package installed from git/a URL rather than PyPI -- see settings.py's own comment on
# this setting for what that changes on the Packages page.
PYOBS_MANAGED_PACKAGES = ["pyobs-core[full]"]

# Generate the password hash with:
#   DJANGO_SETTINGS_MODULE=pyobs_web_admin.settings uv run python -c \
#     "from django.contrib.auth.hashers import make_password; print(make_password('yourpassword'))"
# Break-glass fallback once Keycloak (below) is configured -- kept working rather than removed,
# since it's the only way in if Keycloak itself is unreachable. This same credential also works
# for /admin/ (see modules.views.login_view).
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD_HASH = ""

# Keycloak login (optional addon on top of the shared admin/password login above, not a
# replacement -- leave SERVER_URL unset to disable it entirely; the login page won't show the
# button either). Unlike the shared admin account, a Keycloak-linked person's access is granted
# or revoked via Keycloak group membership (REQUIRED_GROUPS below), not local activation -- new
# accounts mint active by default. Run `manage.py migrate` once before first use (creates
# db.sqlite3, holding the User table and, since sessions are now DB-backed, every session too --
# shared admin/password login included).
# PYOBS_AUTH = {
#     "SERVER_URL": "https://keycloak.example.org",
#     "REALM": "pyobs",
#     "CLIENT_ID": "web-admin",
#     "CLIENT_SECRET": "",
#     "REDIRECT_URI": "https://your.domain.com/accounts/keycloak/callback/",
#     "POST_LOGOUT_REDIRECT_URI": "https://your.domain.com/",
#     # Optional one-click IdP login: IDP_HINT is passed to Keycloak as kc_idp_hint (skips its
#     # login/IdP-selection page, going straight to that identity provider, e.g. GWDG SSO);
#     # IDP_LABEL is the button label on the login page. Leave both unset for the plain
#     # single "Log in with Keycloak" button.
#     "IDP_HINT": "gwdg",
#     "IDP_LABEL": "GWDG",
#     "USER_RESOLVER": "pyobs_web_admin.authentication.keycloak.resolve_user",
#     # Only members of this Keycloak group are authorized to use web-admin -- create it (and
#     # add people to it) in the Keycloak admin console before anyone logs in.
#     "REQUIRED_GROUPS": ["/pyobs-web-admin"],
#     # Keycloak-independent kill switch, layered on top of REQUIRED_GROUPS above: an admin can
#     # deactivate a specific local User (Django admin) regardless of their Keycloak group
#     # membership.
#     "ENFORCE_LOCAL_ACTIVE": True,
# }

# Hub: allow this instance to be controlled by a hub (leave empty to disable).
# Deprecated in favour of HUB_CLIENTS below -- kept working as a "default"-named client.
HUB_TOKEN = ""

# Named tokens for external callers of this instance's API -- a hub, a script, another
# service. Give each caller its own secret so it can be revoked/rotated on its own without
# affecting the others.
# Each entry must have: name (label, shown nowhere but logs), token (shared secret)
# HUB_CLIENTS = [
#     {"name": "hub-monets", "token": "shared-secret"},
#     {"name": "external-script", "token": "another-secret"},
# ]
HUB_CLIENTS = []

# Hub: remote hosts this instance can control
# Each entry must have: name (display label), url (base URL), token (shared secret)
# HUB_HOSTS = [
#     {"name": "obs1", "url": "http://obs1:8765", "token": "shared-secret"},
#     {"name": "obs2", "url": "http://obs2:8765", "token": "another-secret"},
# ]
HUB_HOSTS = []

# ejabberd integration -- see DEV_EJABBERD_INTEGRATION.md. Off by default: not every fleet
# has ejabberd co-located. Uncomment and adjust to enable.
# EJABBERD_ENABLED = True
# EJABBERD_HOST = "localhost"  # name of the HUB_HOSTS entry (or "localhost") running ejabberd
# EJABBERD_DOMAIN = "your-xmpp-domain"
# EJABBERD_API_URL = "http://127.0.0.1:5281/api"
# EJABBERDCTL = "ejabberdctl"

# Git-backed configuration -- see dev-docs/PLAN-git-config2.md. Off by default: set this to
# True to enable Git as a persistence backend for configuration files. All config files under
# PYOBS_CONFIG_DIR are version-controlled, staged automatically after writes, and visible
# in the dashboard Git card. The repository is cloned via sparse checkout so only the
# configured subpath is checked out.
#
# PYOBS_CONFIG_GIT_ROOT is the directory that contains .git — it is the clone destination.
# This must be a fixed location (not derived from PYOBS_CONFIG_DIR) so that after the
# initial clone, changes to PYOBS_CONFIG_DIR do not create nested repositories.
#
# Expected layout (with root "/opt/pyobs/config", subpath "sites/obs1"):
#
#   /opt/pyobs/config/           # <- PYOBS_CONFIG_GIT_ROOT (has .git)
#   ├── .git/
#   ├── sites/
#   │   └── obs1/
#   │       ├── modules/
#   │       └── comm.yaml
#
#   /opt/pyobs/config/sites/obs1 # <- PYOBS_CONFIG_DIR (pyobs reads/writes here)
#
# PYOBS_CONFIG_GIT_ENABLED = True
# PYOBS_CONFIG_GIT_ROOT = "/opt/pyobs/config"
# PYOBS_CONFIG_GIT_REPO = "https://git.example.org/pyobs/config.git"
# PYOBS_CONFIG_GIT_BRANCH = "main"
# PYOBS_CONFIG_GIT_SUBPATH = "sites/obs1"

# ACL Matrix -- fleet-wide view of which module can call which (see /acl/).
# Uncomment to enable the page and sidebar entry.
# PYOBS_CONFIG_ACL_MATRIX_ENABLED = True
